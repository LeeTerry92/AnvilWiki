---
/**
 * Shared homepage entry. Each site supplies localized page definitions through
 * @site/home.page. Most sites use the block registry; exceptional sites can
 * switch to the site-owned home.override.astro while keeping the core layout.
 */
import SiteHomeOverride from '@site/home.override.astro';
import { homePages } from '@site/home.page';
import BlockRenderer from '~/components/home/BlockRenderer.astro';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { site } from '~/config/site';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  alternates?: Array<{ hreflang: string; href: string }>;
}

const { locale, jsonLd = [], alternates = [] } = Astro.props;
const page = homePages[locale] ?? homePages.en;
const meta = {
  title: page.meta.title || site.name,
  description: page.meta.description || site.description,
};
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {page.mode === 'override' ? (
    <SiteHomeOverride locale={locale} page={page} />
  ) : (
    <BlockRenderer sections={page.sections} locale={locale} />
  )}
</LocaleLayout>
