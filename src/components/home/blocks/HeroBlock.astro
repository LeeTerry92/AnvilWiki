---
import { Icon } from 'astro-icon/components';
import VideoSection from '~/components/home/VideoSection.astro';
import { site } from '~/config/site';
import type { Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';
import type { HomeBlock } from '~/platform/home-types';

interface Props {
  block: HomeBlock;
  locale: Locale;
}

const { block, locale } = Astro.props;
if (block.type !== 'hero') throw new Error(`HeroBlock cannot render ${block.type}`);
---

<section class="relative flex min-h-[52vh] items-center overflow-hidden border-b border-border md:min-h-[68vh]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-br from-nav/8 via-transparent to-transparent"></div>
  <span aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 select-none text-center text-[18vw] font-black leading-none text-foreground/[0.03] md:text-[14vw]">
    {site.game.name}
  </span>
  <div class="relative mx-auto w-full max-w-7xl px-4 py-16 md:py-24">
    {block.badge && <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{block.badge}</p>}
    <h1 class="mt-3 max-w-3xl bg-gradient-to-r from-foreground to-foreground/60 bg-clip-text text-4xl font-black tracking-tight text-transparent sm:text-5xl md:text-6xl lg:text-7xl">
      {block.title}
    </h1>
    <p class="mt-5 max-w-xl text-base text-muted-foreground md:text-lg">{block.description}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {block.primaryLabel && (
        <a href={site.social.official} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <Icon name="lucide:play" class="mr-2 h-4 w-4" />
          {block.primaryLabel}
        </a>
      )}
      {block.secondaryLabel && block.secondaryHref && (
        <a href={localizePath(block.secondaryHref, locale)} class="btn-outline">{block.secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

{block.videoId && <VideoSection videoId={block.videoId} title={`${site.game.name} trailer`} />}
